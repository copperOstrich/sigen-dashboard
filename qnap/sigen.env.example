# Save as /share/Container/sigen-dashboard/sigen.env on the NAS, then restart the container
# after any change.
TZ=Australia/Sydney

# SigenStor: keep SIGEN_SIMULATE=1 until Modbus TCP is enabled, then set it to 0 and put
# your inverter's fixed IP address in SIGEN_HOST.
SIGEN_SIMULATE=1
SIGEN_HOST=192.168.1.60
SIGEN_PORT=502
SIGEN_PLANT_UNIT=247
SIGEN_INVERTER_UNIT=1
# Sigen AC charger: auto = find it by scanning, a number = its Modbus unit id,
# plant = it has no Modbus address (use the inverter's figures), 0 = no charger
SIGEN_CHARGER_UNIT=auto

# Retailer prices (optional, pick one)
AMBER_API_KEY=
LOCALVOLTS_API_KEY=
LOCALVOLTS_PARTNER_ID=

# AEMO wholesale data: NSW1, QLD1, VIC1, SA1 or TAS1
AEMO_REGION=NSW1
