# Copy to .env and fill in.

# --- SigenStor (Modbus TCP) ---------------------------------------------
# Until Modbus TCP is enabled, leave SIGEN_SIMULATE=1 to run on simulated data.
SIGEN_SIMULATE=1
# Optional: make the simulator resemble your system
# SIM_PV_KWP=10
# SIM_BATTERY_KWH=16
# SIM_INVERTER_KW=10
# SIM_EXPORT_LIMIT_KW=5
# Then set SIGEN_SIMULATE=0 and your inverter's IP (give it a fixed IP in your router).
SIGEN_HOST=192.168.1.60
SIGEN_PORT=502
SIGEN_PLANT_UNIT=247
SIGEN_INVERTER_UNIT=1
# Sigen AC charger: auto = find it by scanning, a number = its Modbus unit id,
# plant = it has no Modbus address (use the inverter's figures), 0 = no charger
SIGEN_CHARGER_UNIT=auto
# PV insulation resistance (MΩ): healthy is about 0.5-0.8; warn below WARN, fault below MIN
# (about where the inverter shuts down to protect itself)
INSULATION_WARN_MOHM=0.5
INSULATION_MIN_MOHM=0.37

# Weather and solar forecast (Open-Meteo, free, no account). Where the panels are: either
# SITE_LAT/SITE_LON (from Google Maps: right-click your roof), or an address or suburb to look up.
SITE_LAT=
SITE_LON=
SITE_ADDRESS=
# Array size in kW, and optionally each roof face as tilt:azimuth:kW (azimuth 0 = north,
# 90 = east, 270 = west), e.g. SOLAR_PLANES=22:90:6.6,22:270:6.6,10:0:5.33
SOLAR_KWP=
SOLAR_PLANES=
POLL_SECONDS=5

# --- Money (optional) ----------------------------------------------------
# Compare with the Default Market Offer for your network: nsw-ausgrid, nsw-endeavour or nsw-essential
# (or put your own plans.json in the data folder; see collector/plans/)
COMPARE_PLANS=
# Your own retailer's daily supply charge (c/day) and monthly fee ($), from your bill
RETAILER_SUPPLY_C_DAY=
RETAILER_FEE_MONTHLY=
# The day you started with your current retailer (YYYY-MM-DD), if after the system went in
RETAILER_SINCE=
# What the solar and battery cost ($) and when it was switched on (YYYY-MM-DD), for payback
SYSTEM_COST=
SYSTEM_INSTALLED=

# --- Retailer prices (optional, pick one) --------------------------------
# Amber Electric: app.amber.com.au -> Developers -> Generate new token
AMBER_API_KEY=
# Only needed if your account has more than one site
AMBER_SITE_ID=

# LocalVolts: localvolts.com -> My Profile -> API Key
LOCALVOLTS_API_KEY=
LOCALVOLTS_PARTNER_ID=
# Only needed if your account has more than one NMI
LOCALVOLTS_NMI=

# amber, localvolts or none (default: whichever has a key)
# PRICE_PROVIDER=

# --- AEMO market data (free, no account) --------------------------------
# Your NEM region: NSW1, QLD1, VIC1, SA1 or TAS1
AEMO_REGION=NSW1
# AEMO_ENABLED=0 turns it off

TZ=Australia/Sydney
